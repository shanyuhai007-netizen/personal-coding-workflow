{
  "version": 1,
  "facts": [
    "behavior_change",
    "bug",
    "ui",
    "react",
    "interaction",
    "nontrivial",
    "multi_unit",
    "performance",
    "formal_decision",
    "unfamiliar_api",
    "business_unknown",
    "existing_implementation",
    "implementation_complete"
  ],
  "intents": [
    "implement",
    "design",
    "review",
    "research",
    "question"
